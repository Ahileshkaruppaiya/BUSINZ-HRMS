# ==============================================================================
# VRM Enterprise HRMS - Payroll Backend Environment Variables
# ==============================================================================

PORT=8000
NODE_ENV=development

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Session Verification
JWT_SECRET=vrm-hrms-dev-jwt-secret-key-replace-in-production-2026

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Direct PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=25000